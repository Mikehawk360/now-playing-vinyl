# Copy to .env and fill in. .env is gitignored - never commit the token.

AUDD_TOKEN=your-audd-api-token

# The relay. If it runs on this same tablet, localhost is right.
RELAY_URL=http://localhost:8080
# Only if you set RELAY_TOKEN on the relay too.
RELAY_TOKEN=

# Seconds between recognition attempts. 120 = 30 tries/hour. AudD gives
# 300 free requests, then ~$5/1000, so keep this generous.
POLL_INTERVAL=120

# Clip length to record and send for each attempt.
CLIP_SECONDS=8

# Consecutive no-matches before the relay is cleared (blank screen).
# 0 disables clearing - last album art stays up until the next match.
CLEAR_AFTER_MISSES=3

# Pixel size for Apple Music artwork (its URL is a {w}x{h} template).
ART_SIZE=1000
